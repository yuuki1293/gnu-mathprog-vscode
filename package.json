{
  "name": "gnu-mathprog",
  "displayName": "GNU MathProg",
  "description": "GNU MathProg editing and GLPK execution support for VS Code.",
  "version": "0.4.1",
  "publisher": "mathprog-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "glpk",
    "mathprog",
    "gmpl",
    "optimization"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:mathprog",
    "onDebug:mathprog",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing features work; executing GLPK requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --out ../gnu-mathprog-0.4.1.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "vscode-textmate": "^9.2.0",
    "vscode-oniguruma": "^2.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "mathprog",
        "aliases": [
          "GNU MathProg",
          "MathProg",
          "GMPL"
        ],
        "extensions": [
          ".mod",
          ".mpl",
          ".mathprog",
          ".dat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mathprog",
        "scopeName": "source.mathprog",
        "path": "./syntaxes/mathprog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mathprog",
        "path": "./snippets/mathprog.json"
      }
    ],
    "commands": [
      {
        "command": "mathprog.run",
        "title": "Run Configuration",
        "category": "MathProg",
        "icon": "$(play)"
      },
      {
        "command": "mathprog.check",
        "title": "Check Configuration",
        "category": "MathProg",
        "icon": "$(check)"
      },
      {
        "command": "mathprog.createConfiguration",
        "title": "Create Run Configuration",
        "category": "MathProg"
      },
      {
        "command": "mathprog.selectConfiguration",
        "title": "Select Run Configuration",
        "category": "MathProg"
      },
      {
        "command": "mathprog.showOutput",
        "title": "Show Output",
        "category": "MathProg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mathprog.run",
          "when": "resourceLangId == mathprog && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "mathprog.check",
          "when": "resourceLangId == mathprog && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "mathprog.selectConfiguration",
          "when": "resourceLangId == mathprog",
          "group": "mathprog@1"
        }
      ]
    },
    "configuration": {
      "title": "GNU MathProg",
      "properties": {
        "mathprog.glpsolPath": {
          "type": "string",
          "default": "glpsol",
          "scope": "machine-overridable",
          "description": "GLPK glpsol executable name or absolute path (without arguments)."
        },
        "mathprog.timeLimit": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 86400,
          "description": "Solver time limit in seconds. A separate watchdog stops a process after this limit plus 5 seconds."
        }
      }
    },
    "debuggers": [
      {
        "type": "mathprog",
        "label": "GNU MathProg",
        "languages": [
          "mathprog"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "model"
            ],
            "properties": {
              "model": {
                "type": "string",
                "description": "実行するモデルファイル。相対パスはワークスペースフォルダーが基準です。",
                "default": "${workspaceFolder}/model.mod"
              },
              "data": {
                "type": "array",
                "description": "データファイルを読み込む順に指定。空の配列ではモデル内のデータを使用します。",
                "items": {
                  "type": "string"
                },
                "maxItems": 10,
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "GLPKを実行する作業フォルダー。既定はワークスペースフォルダー。",
                "default": "${workspaceFolder}"
              },
              "action": {
                "type": "string",
                "enum": [
                  "run",
                  "check"
                ],
                "default": "run",
                "description": "モデルの実行または生成の検査。"
              },
              "glpsolPath": {
                "type": "string",
                "description": "この構成で使うglpsolの名前またはパス。省略時はmathprog.glpsolPath。"
              },
              "timeLimit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400,
                "description": "この構成の制限時間（秒）。省略時はmathprog.timeLimit。"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mathprog",
            "request": "launch",
            "name": "MathProg: Run",
            "model": "${workspaceFolder}/model.mod",
            "data": [],
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "MathProg: Run model",
            "description": "モデルとデータを指定する実行構成",
            "body": {
              "type": "mathprog",
              "request": "launch",
              "name": "MathProg: Run",
              "model": "${workspaceFolder}/model.mod",
              "data": [],
              "cwd": "${workspaceFolder}"
            }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuuki1293/gnu-mathprog-vscode.git"
  },
  "homepage": "https://github.com/yuuki1293/gnu-mathprog-vscode#readme",
  "bugs": {
    "url": "https://github.com/yuuki1293/gnu-mathprog-vscode/issues"
  }
}
